# Copy to .env.local and fill in real values. Never commit .env.local.
# Ask a project admin for dev/sandbox credentials — do not reuse production keys locally.

# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Anthropic (Claude)
ANTHROPIC_API_KEY=

# Google Cloud / Vertex AI (image generation)
GOOGLE_SERVICE_ACCOUNT_JSON=
GOOGLE_CLOUD_PROJECT=
GOOGLE_VERTEX_LOCATION=
GOOGLE_VERTEX_IMAGE_LOCATION=
GEMINI_IMAGE_MODEL=
ANALYSIS_PROVIDER=

# PayPal — defaults to sandbox unless PAYPAL_ENVIRONMENT=live exactly
NEXT_PUBLIC_PAYPAL_CLIENT_ID=
PAYPAL_SECRET=
PAYPAL_ENVIRONMENT=sandbox
PAYPAL_WEBHOOK_ID=

# Razorpay — test vs. live is whichever key pair you use (rzp_test_ / rzp_live_)
NEXT_PUBLIC_RAZORPAY_KEY_ID=
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
NEXT_PUBLIC_RAZORPAY_USD_TO_INR=

# Email
RESEND_API_KEY=
CONSULTATION_LEAD_EMAIL=

# Misc
NEXT_PUBLIC_SITE_URL=http://localhost:3000
CRON_SECRET=
REPORT_DEMO_PROMO_CODE=
