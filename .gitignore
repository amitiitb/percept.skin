# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
*.bak
.env.local

# design reference material — kept locally for design work, not shipped/tracked
/report copy
/design-reference-screenshots
VERCEL-GOOGLE-SERVICE-ACCOUNT.json
# Root-level design sources only (~10MB of PNGs). Assets under public/ are
# still tracked normally — this pattern is anchored to the repo root.
/*.png

# local tooling scratch
/.playwright-mcp
/glowmetry-v2
